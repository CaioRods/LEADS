{
  "name": "prospecapp",
  "version": "1.0.0",
  "description": "ProspecApp - Gerenciador de prospecção de clientes. Sem login, sem nuvem.",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:dmg": "electron-builder --mac dmg",
    "build:all": "electron-builder -mwl",
    "update-app": "node atualizar-app.js",
    "funcionamento": "node funcionamento.js",
    "mcp": "node mcp-server.js"
  },
  "keywords": [
    "prospecção",
    "clientes",
    "vendas",
    "CRM",
    "desktop"
  ],
  "author": "ProspecApp",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "latest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "baileys": "^6.17.16",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.prospecapp.app",
    "productName": "ProspecApp",
    "directories": {
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "index.html",
      "styles.css",
      "app-web.js",
      "score.js",
      "buscar-fotos.js",
      "geocodificar.js",
      "node_modules/**/*",
      "assets/**/*",
      "dados.json",
      "funcionamento.js",
      "wa-worker.js",
      "wa-ponte.js",
      "helo.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.business",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150,
          "type": "file"
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "icon": "assets/icon-256.png"
    },
    "linux": {
      "icon": "assets/icon-512.png"
    },
    "asarUnpack": [
      "wa-worker.js",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/baileys/**/*"
    ]
  }
}
